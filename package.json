{
  "name": "songforge-os",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous artist operating system for BLAIZE SUNDAY.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @songforge/web build",
    "start": "pnpm --filter @songforge/web start",
    "dev": "pnpm --filter @songforge/web dev",
    "worker": "pnpm --filter @songforge/worker start",
    "test": "NODE_OPTIONS='--experimental-strip-types --no-warnings=ExperimentalWarning' pnpm -r --if-present test && NODE_OPTIONS='--experimental-strip-types --no-warnings=ExperimentalWarning' node --test apps/routenote-runner/src/*.test.ts",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p apps/routenote-runner/tsconfig.json --noEmit",
    "lint": "pnpm -r --if-present lint",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "album:bootstrap": "pnpm --filter @songforge/album bootstrap",
    "album:audit": "pnpm --filter @songforge/album audit",
    "album:render": "pnpm --filter @songforge/album render",
    "album:validate": "pnpm --filter @songforge/album validate",
    "routenote:login": "node --experimental-strip-types --no-warnings=ExperimentalWarning apps/routenote-runner/src/cli.ts login",
    "routenote:upload": "node --experimental-strip-types --no-warnings=ExperimentalWarning apps/routenote-runner/src/cli.ts upload",
    "db:generate": "pnpm --filter @songforge/database db:generate",
    "db:validate": "pnpm --filter @songforge/database db:validate",
    "db:push": "pnpm --filter @songforge/database db:push",
    "db:migrate": "pnpm --filter @songforge/database db:migrate",
    "db:seed": "pnpm --filter @songforge/database db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
