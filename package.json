{
  "name": "songforge-os",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous artist operating system for BLAIZE SUNDAY.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@songforge/web",
    "build": "npm run build --workspace=@songforge/web",
    "start": "npm run start --workspace=@songforge/web",
    "worker": "npm run start --workspace=@songforge/worker",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "album:bootstrap": "npm run bootstrap --workspace=@songforge/album",
    "album:audit": "npm run audit --workspace=@songforge/album",
    "album:render": "npm run render --workspace=@songforge/album",
    "album:validate": "npm run validate --workspace=@songforge/album",
    "routenote:login": "node --experimental-strip-types --no-warnings=ExperimentalWarning apps/routenote-runner/src/cli.ts login",
    "routenote:upload": "node --experimental-strip-types --no-warnings=ExperimentalWarning apps/routenote-runner/src/cli.ts upload",
    "db:generate": "npm run db:generate --workspace=@songforge/database",
    "db:validate": "npm run db:validate --workspace=@songforge/database",
    "db:push": "npm run db:push --workspace=@songforge/database",
    "db:migrate": "npm run db:migrate --workspace=@songforge/database",
    "db:seed": "npm run db:seed --workspace=@songforge/database"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}