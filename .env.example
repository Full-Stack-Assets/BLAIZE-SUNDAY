# PostgreSQL (required for Prisma-backed APIs)
DATABASE_URL=postgresql://songforge:songforge@localhost:5432/songforge?schema=public

# Redis (optional). When unset, CREATE NEXT RELEASE runs inline and reports queue UNCONFIGURED.
REDIS_URL=redis://localhost:6379

# S3-compatible storage (optional for general SongForge storage).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=songforge
S3_ACCESS_KEY=songforge
S3_SECRET_KEY=songforge-secret
S3_FORCE_PATH_STYLE=true

# Server-only operator token for existing mutating SongForge APIs.
APPROVAL_API_TOKEN=replace-with-a-long-random-token

# Server-only RouteNote owner-control credential. This is NOT a RouteNote password.
ROUTENOTE_CONTROL_PASSPHRASE=replace-with-a-long-random-passphrase

# RouteNote private runtime. Production Fly defaults are under /data.
ROUTENOTE_STATE_ROOT=.songforge/routenote
ROUTENOTE_PROFILE_DIR=.songforge/routenote/browser-profile
ROUTENOTE_MEDIA_ROOT=.songforge/routenote/media
ROUTENOTE_BROWSER_EXECUTABLE_PATH=
ROUTENOTE_HEADLESS=1
ROUTENOTE_CLOSE_BROWSER=1
ROUTENOTE_LOGIN_TIMEOUT_MS=900000
ROUTENOTE_ASSET_HOST_ALLOWLIST=
ROUTENOTE_ASSET_MAX_BYTES=1500000000
ROUTENOTE_ASSET_FETCH_TIMEOUT_MS=30000
ROUTENOTE_SELECTOR_CONTRACT_VERSION=UNVERIFIED

# LLM. Live mode never accepts client-supplied keys and never falls back to the local engine.
SONGFORGE_MODE=live
OPENAI_API_KEY=
GROK_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional providers - fail closed when empty
ELEVENLABS_API_KEY=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
GOOGLE_DRIVE_FOLDER_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
DSP_API_TOKEN=

# Monthly paid-provider budget. 0 = verified zero-cost internal work only.
MONTHLY_BUDGET_USD=0
